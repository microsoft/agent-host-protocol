{
  "description": "A data message larger than the accepted maximumFrameBytes closes the connection with a protocol error.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {},
      "receive": "auto"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 4096,
            "maximumFrameBytes": 1024
          },
          "hostReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"snapshot\":{\"resource\":\"ahp-terminal:/t1\",\"state\":{\"title\":\"Shell\",\"content\":[],\"lifecycle\":{\"status\":\"running\"},\"claim\":{\"kind\":\"client\",\"clientId\":\"client-1\"}},\"fromSeq\":5}}}"
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"action\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"action\":{\"type\":\"terminal/data\",\"data\":\"\"},\"serverSeq\":6}}"
    },
    {
      "op": "expectClosed"
    }
  ]
}
