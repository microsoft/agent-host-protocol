{
  "description": "An unknown notification for the channel counts against the window and is delivered. A host channel/credit is a control message and does not count.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {},
      "receive": "auto"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          },
          "hostReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"snapshot\":{\"resource\":\"ahp-terminal:/t1\",\"state\":{\"title\":\"Shell\",\"content\":[],\"lifecycle\":{\"status\":\"running\"},\"claim\":{\"kind\":\"client\",\"clientId\":\"client-1\"}},\"fromSeq\":5}}}"
    },
    {
      "op": "next",
      "channel": "ahp-terminal:/t1",
      "expect": {
        "method": "channel/snapshot",
        "params": {
          "channel": "ahp-terminal:/t1",
          "snapshot": {
            "resource": "ahp-terminal:/t1",
            "state": {
              "title": "Shell",
              "content": [],
              "lifecycle": {
                "status": "running"
              },
              "claim": {
                "kind": "client",
                "clientId": "client-1"
              }
            },
            "fromSeq": 5
          }
        }
      },
      "expectBytes": 520
    },
    {
      "op": "advance",
      "channel": "ahp-terminal:/t1"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "channel/credit",
        "params": {
          "channel": "ahp-terminal:/t1",
          "consumedBytes": 520
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/credit\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"consumedBytes\":0}}"
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"ext/ping\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"n\":1}}"
    },
    {
      "op": "next",
      "channel": "ahp-terminal:/t1",
      "expect": {
        "method": "ext/ping",
        "params": {
          "channel": "ahp-terminal:/t1",
          "n": 1
        }
      },
      "expectBytes": 166
    },
    {
      "op": "advance",
      "channel": "ahp-terminal:/t1"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "channel/credit",
        "params": {
          "channel": "ahp-terminal:/t1",
          "consumedBytes": 686
        }
      }
    }
  ]
}
