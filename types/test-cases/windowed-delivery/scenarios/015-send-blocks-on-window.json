{
  "description": "Data sent by the consumer waits when the host window is full and resumes on credit. Each message is about 750 bytes against a 1000-byte host window.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {}
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          },
          "hostReceive": {
            "windowBytes": 1000,
            "maximumFrameBytes": 16384
          }
        }
      }
    },
    {
      "op": "expectStatus",
      "channel": "ahp-terminal:/t1",
      "match": {
        "writable": true
      }
    },
    {
      "op": "send",
      "channel": "ahp-terminal:/t1",
      "method": "dispatchAction",
      "params": {
        "channel": "ahp-terminal:/t1",
        "clientSeq": 1,
        "action": {
          "type": "terminal/input",
          "data": ""
        }
      }
    },
    {
      "op": "send",
      "channel": "ahp-terminal:/t1",
      "method": "dispatchAction",
      "params": {
        "channel": "ahp-terminal:/t1",
        "clientSeq": 2,
        "action": {
          "type": "terminal/input",
          "data": ""
        }
      }
    },
    {
      "op": "send",
      "channel": "ahp-terminal:/t1",
      "method": "dispatchAction",
      "params": {
        "channel": "ahp-terminal:/t1",
        "clientSeq": 3,
        "action": {
          "type": "terminal/input",
          "data": ""
        }
      }
    },
    {
      "op": "expectSent",
      "match": {
        "method": "dispatchAction",
        "params": {
          "channel": "ahp-terminal:/t1",
          "clientSeq": 1,
          "action": {
            "type": "terminal/input",
            "data": ""
          }
        }
      }
    },
    {
      "op": "expectSent",
      "match": {
        "method": "dispatchAction",
        "params": {
          "channel": "ahp-terminal:/t1",
          "clientSeq": 2,
          "action": {
            "type": "terminal/input",
            "data": ""
          }
        }
      }
    },
    {
      "op": "expectNotSent",
      "match": {
        "method": "dispatchAction"
      },
      "withinMs": 150
    },
    {
      "op": "expectStatus",
      "channel": "ahp-terminal:/t1",
      "match": {
        "writable": false
      }
    },
    {
      "op": "hostCreditsAll",
      "channel": "ahp-terminal:/t1"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "dispatchAction",
        "params": {
          "channel": "ahp-terminal:/t1",
          "clientSeq": 3,
          "action": {
            "type": "terminal/input",
            "data": ""
          }
        }
      }
    }
  ]
}
