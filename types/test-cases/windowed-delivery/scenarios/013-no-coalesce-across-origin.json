              "title": "Shell",
              "content": [],
              "lifecycle": {
                "status": "running"
              },
              "claim": {
                "kind": "client",
                "clientId": "client-1"
              }
            },
            "fromSeq": 5
          }
        }
      },
      "expectBytes": 520
