{
  "description": "An action with an origin is never merged, so its neighbors are not adjacent and stay separate.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {}
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          },
          "hostReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"snapshot\":{\"resource\":\"ahp-terminal:/t1\",\"state\":{\"title\":\"Shell\",\"content\":[],\"lifecycle\":{\"status\":\"running\"},\"claim\":{\"kind\":\"client\",\"clientId\":\"client-1\"}},\"fromSeq\":5}}}"
    },
    {
      "op": "next",
