{
  "description": "A single message larger than maxBufferedSendBytes is accepted when nothing else is queued, and is sent in fragments.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384,
    "maxBufferedSendBytes": 4096
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {}
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          },
          "hostReceive": {
            "windowBytes": 1048576,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "expectStatus",
      "channel": "ahp-terminal:/t1",
      "match": {
        "writable": true
      }
    },
    {
      "op": "send",
      "channel": "ahp-terminal:/t1",
      "method": "dispatchAction",
      "params": {
        "channel": "ahp-terminal:/t1",
        "clientSeq": 1,
        "action": {
          "type": "terminal/input",
          "data": ""
        }
      }
    },
    {
      "op": "expectSent",
      "reassemble": true,
      "match": {
        "method": "dispatchAction",
        "params": {
          "channel": "ahp-terminal:/t1",
          "clientSeq": 1,
          "action": {
            "type": "terminal/input",
            "data": ""
          }
        }
      }
    }
  ]
}
