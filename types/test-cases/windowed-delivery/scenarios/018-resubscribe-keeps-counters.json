{
  "description": "A second subscribe on a windowed subscription changes its limits; counters continue, so credit after the new snapshot is cumulative.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {},
      "receive": "auto"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          },
          "hostReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"snapshot\":{\"resource\":\"ahp-terminal:/t1\",\"state\":{\"title\":\"Shell\",\"content\":[],\"lifecycle\":{\"status\":\"running\"},\"claim\":{\"kind\":\"client\",\"clientId\":\"client-1\"}},\"fromSeq\":5}}}"
    },
    {
      "op": "next",
      "channel": "ahp-terminal:/t1",
      "expect": {
        "method": "channel/snapshot",
        "params": {
          "channel": "ahp-terminal:/t1",
          "snapshot": {
            "resource": "ahp-terminal:/t1",
            "state": {
              "title": "Shell",
              "content": [],
              "lifecycle": {
                "status": "running"
              },
              "claim": {
                "kind": "client",
                "clientId": "client-1"
              }
            },
            "fromSeq": 5
          }
        }
      },
      "expectBytes": 520
    },
    {
      "op": "advance",
      "channel": "ahp-terminal:/t1"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "channel/credit",
        "params": {
          "channel": "ahp-terminal:/t1",
          "consumedBytes": 520
        }
      }
    },
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {
        "windowBytes": 2048
      }
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 2048,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 2048,
            "maximumFrameBytes": 1024
          },
          "hostReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "expectStatus",
      "channel": "ahp-terminal:/t1",
      "match": {
        "limits": {
          "clientReceive": {
            "windowBytes": 2048
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-terminal:/t1\",\"snapshot\":{\"resource\":\"ahp-terminal:/t1\",\"state\":{\"title\":\"Shell\",\"content\":[],\"lifecycle\":{\"status\":\"running\"},\"claim\":{\"kind\":\"client\",\"clientId\":\"client-1\"}},\"fromSeq\":5}}}"
    },
    {
      "op": "next",
      "channel": "ahp-terminal:/t1",
      "expect": {
        "method": "channel/snapshot",
        "params": {
          "channel": "ahp-terminal:/t1",
          "snapshot": {
            "resource": "ahp-terminal:/t1",
            "state": {
              "title": "Shell",
              "content": [],
              "lifecycle": {
                "status": "running"
              },
              "claim": {
                "kind": "client",
                "clientId": "client-1"
              }
            },
            "fromSeq": 5
          }
        }
      },
      "expectBytes": 520
    },
    {
      "op": "advance",
      "channel": "ahp-terminal:/t1"
    },
    {
      "op": "expectSent",
      "match": {
        "method": "channel/credit",
        "params": {
          "channel": "ahp-terminal:/t1",
          "consumedBytes": 1040
        }
      }
    }
  ]
}
