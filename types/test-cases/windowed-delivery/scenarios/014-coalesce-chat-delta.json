{
  "description": "Adjacent chat/delta actions for the same turn and part are concatenated; a different part is not merged.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-chat:/c1",
      "window": {}
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-chat:/c1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          },
          "hostReceive": {
            "windowBytes": 65536,
            "maximumFrameBytes": 16384
          }
        }
      }
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"channel/snapshot\",\"params\":{\"channel\":\"ahp-chat:/c1\",\"snapshot\":{\"resource\":\"ahp-chat:/c1\",\"state\":{\"resource\":\"ahp-chat:/c1\",\"title\":\"s\",\"status\":1,\"modifiedAt\":\"2026-01-01T00:00:00Z\",\"turns\":[]},\"fromSeq\":1}}}"
    },
    {
      "op": "next",
      "channel": "ahp-chat:/c1",
      "expect": {
        "method": "channel/snapshot"
      },
      "expectBytes": 476
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"action\",\"params\":{\"channel\":\"ahp-chat:/c1\",\"action\":{\"type\":\"chat/delta\",\"turnId\":\"turn-1\",\"partId\":\"p1\",\"content\":\"Hel\"},\"serverSeq\":2}}"
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"action\",\"params\":{\"channel\":\"ahp-chat:/c1\",\"action\":{\"type\":\"chat/delta\",\"turnId\":\"turn-1\",\"partId\":\"p1\",\"content\":\"lo\"},\"serverSeq\":3}}"
    },
    {
      "op": "hostSends",
      "text": "{\"jsonrpc\":\"2.0\",\"method\":\"action\",\"params\":{\"channel\":\"ahp-chat:/c1\",\"action\":{\"type\":\"chat/delta\",\"turnId\":\"turn-1\",\"partId\":\"p2\",\"content\":\"!\"},\"serverSeq\":4}}"
    },
    {
      "op": "expectStatus",
      "channel": "ahp-chat:/c1",
      "match": {
        "bufferedReceiveBytes": 1454
      }
    },
    {
      "op": "next",
      "channel": "ahp-chat:/c1",
      "expect": {
        "method": "action",
        "params": {
          "action": {
            "type": "chat/delta",
            "partId": "p1",
            "content": "Hello"
          },
          "serverSeq": 3
        }
      },
      "expectBytes": 654
    },
    {
      "op": "next",
      "channel": "ahp-chat:/c1",
      "expect": {
        "method": "action",
        "params": {
          "channel": "ahp-chat:/c1",
          "action": {
            "type": "chat/delta",
            "turnId": "turn-1",
            "partId": "p2",
            "content": "!"
          },
          "serverSeq": 4
        }
      },
      "expectBytes": 324
    }
  ]
}
