{
  "description": "Accepted clientReceive limits higher than the offer close the connection with a protocol error.",
  "windowing": {
    "windowBytes": 262144,
    "maximumFrameBytes": 16384
  },
  "steps": [
    {
      "op": "subscribe",
      "channel": "ahp-terminal:/t1",
      "window": {}
    },
    {
      "op": "expectSent",
      "match": {
        "method": "subscribe",
        "params": {
          "channel": "ahp-terminal:/t1",
          "flowControl": {
            "receive": {
              "windowBytes": 262144,
              "maximumFrameBytes": 16384
            }
          }
        }
      }
    },
    {
      "op": "respond",
      "to": "subscribe",
      "result": {
        "flowControl": {
          "clientReceive": {
            "windowBytes": 999999,
            "maximumFrameBytes": 16384
          },
          "hostReceive": {
            "windowBytes": 512,
            "maximumFrameBytes": 1024
          }
        }
      }
    },
    {
      "op": "expectClosed"
    }
  ]
}
