{
  "description": "changeset/fileSet appends an editing file without changing a sibling's review state",
  "reducer": "changeset",
  "initial": {
    "status": "ready",
    "files": [
      { "id": "file:///b.txt", "edit": {}, "nonce": "b-1", "reviewed": true }
    ]
  },
  "actions": [
    {
      "type": "changeset/fileSet",
      "file": { "id": "file:///a.txt", "edit": {}, "nonce": "a-1", "isEditing": true }
    }
  ],
  "expected": {
    "status": "ready",
    "files": [
      { "id": "file:///b.txt", "edit": {}, "nonce": "b-1", "reviewed": true },
      { "id": "file:///a.txt", "edit": {}, "nonce": "a-1", "isEditing": true }
    ]
  }
}
