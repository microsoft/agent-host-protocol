{
  "description": "tunnel client updated replaces client lifecycle in both directions",
  "reducer": "tunnel",
  "initial": {
    "ports": [
      {
        "resource": "ahp-tunnel:/preview",
        "direction": "hostToClient",
        "requestedLocalAddress": { "host": "127.0.0.1", "port": 0 },
        "requestedRemoteAddress": { "host": "127.0.0.1", "port": 3000 },
        "clients": [{
          "clientId": "client-1",
          "state": { "status": "pending" }
        }],
        "requestedBy": { "kind": "host" },
        "createdAt": "2026-08-24T18:00:00Z"
      },
      {
        "resource": "ahp-tunnel:/callback",
        "direction": "clientToHost",
        "requestedLocalAddress": { "host": "127.0.0.1", "port": 0 },
