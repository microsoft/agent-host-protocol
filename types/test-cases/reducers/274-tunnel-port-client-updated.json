      "state": {
        "status": "ready",
        "localAddress": { "host": "127.0.0.1", "port": 53142 },
        "remoteAddress": { "host": "127.0.0.1", "port": 3000 }
      }
    },
    {
      "type": "tunnel/portClientUpdated",
      "resource": "ahp-tunnel:/callback",
      "clientId": "client-2",
      "state": {
        "status": "failed",
        "error": { "errorType": "bind", "message": "Port is unavailable" }
      }
    }
  ],
  "expected": {
    "ports": [
      {
        "resource": "ahp-tunnel:/preview",
        "direction": "hostToClient",
        "requestedLocalAddress": { "host": "127.0.0.1", "port": 0 },
