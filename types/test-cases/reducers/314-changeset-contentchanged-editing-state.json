{
  "description": "A full changeset refresh replaces file status while preserving unchanged operations",
  "reducer": "changeset",
  "initial": {
    "status": "recomputing",
    "files": [
      { "id": "file:///a.txt", "edit": {}, "nonce": "a-1", "status": 1 },
      { "id": "file:///b.txt", "edit": {}, "nonce": "b-1" }
    ],
    "operations": [{ "id": "accept", "label": "Accept", "scopes": ["resource"], "status": "idle" }]
  },
  "actions": [
    {
      "type": "changeset/contentChanged",
      "files": [
        { "id": "file:///a.txt", "edit": {}, "nonce": "a-2" },
        { "id": "file:///b.txt", "edit": {}, "nonce": "b-1", "status": 1 }
      ]
    },
    { "type": "changeset/statusChanged", "status": "ready" }
  ],
  "expected": {
    "status": "ready",
    "files": [
      { "id": "file:///a.txt", "edit": {}, "nonce": "a-2" },
      { "id": "file:///b.txt", "edit": {}, "nonce": "b-1", "status": 1 }
    ],
    "operations": [{ "id": "accept", "label": "Accept", "scopes": ["resource"], "status": "idle" }]
  }
}
