{
  "description": "Rich same-URI set upgrades a legacy entry without changing order",
  "reducer": "session",
  "initial": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": ["file:///a", "file:///b", { "uri": "file:///c", "origin": { "kind": "local" } }]
  },
  "actions": [{
    "type": "session/workingDirectorySet",
    "directory": { "uri": "file:///b", "repo": "https://example.org/project.git", "origin": { "kind": "repo" } }
  }],
  "expected": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [
      "file:///a",
      { "uri": "file:///b", "repo": "https://example.org/project.git", "origin": { "kind": "repo" } },
      { "uri": "file:///c", "origin": { "kind": "local" } }
    ]
  }
}
