{
  "description": "root/modelSourceSet adds a model source to an absent registry, storing it without the definition",
  "reducer": "root",
  "initial": {
    "agents": []
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1"
      },
      "definition": {
        "baseUrl": "https://apia.example.com/v1",
        "models": [
          "model-a"
        ]
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1"
      }
    ]
  }
}
