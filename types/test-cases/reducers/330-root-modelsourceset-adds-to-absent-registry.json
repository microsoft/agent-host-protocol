{
  "description": "root/modelSourceSet adds a model source, including its definition, to an absent registry",
  "reducer": "root",
  "initial": {
    "agents": []
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1"
      }
    ]
  }
}
