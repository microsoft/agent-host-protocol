{
  "description": "accounts/set appends a new lifetime without changing another account",
  "reducer": "accounts",
  "initial": {
    "accounts": [{ "id": "account-b", "label": "B", "removable": true, "consumers": [] }],
    "attempts": []
  },
  "actions": [{
    "type": "accounts/set",
    "account": {
      "id": "account-a", "label": "A", "removable": true,
      "consumers": [{ "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" }]
    }
  }],
  "expected": {
    "accounts": [
      { "id": "account-b", "label": "B", "removable": true, "consumers": [] },
      {
        "id": "account-a", "label": "A", "removable": true,
        "consumers": [{ "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" }]
      }
    ],
    "attempts": []
  }
}
