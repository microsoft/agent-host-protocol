{
  "description": "Replacement changes the selected primary URI and provenance atomically",
  "reducer": "session",
  "initial": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [{ "uri": "file:///a", "origin": { "kind": "local" } }, "file:///b"]
  },
  "actions": [{
    "type": "session/workingDirectoryReplaced", "directory": "file:///a",
    "replacement": {
      "uri": "file:///tree/packages/api", "repo": "https://example.org/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///a" }
    }
  }],
  "expected": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [{
      "uri": "file:///tree/packages/api", "repo": "https://example.org/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///a" }
    }, "file:///b"]
  }
}
