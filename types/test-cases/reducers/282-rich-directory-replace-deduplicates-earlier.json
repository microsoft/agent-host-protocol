{
  "description": "A rich replacement refreshes an earlier same-URI record without moving its primary slot",
  "reducer": "session",
  "initial": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [{ "uri": "file:///a", "origin": { "kind": "local" } }, "file:///b", "file:///c"]
  },
  "actions": [{
    "type": "session/workingDirectoryReplaced", "directory": "file:///c",
    "replacement": { "uri": "file:///a", "repo": "https://example.org/project.git", "origin": { "kind": "repo" } }
  }],
  "expected": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [{ "uri": "file:///a", "repo": "https://example.org/project.git", "origin": { "kind": "repo" } }, "file:///b"]
  }
}
