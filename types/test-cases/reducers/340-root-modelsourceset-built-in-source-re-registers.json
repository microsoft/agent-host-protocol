{
  "description": "root/modelSourceSet for a built-in source with no format, definition, or nonce re-registers it when provider matches and format and nonce are both absent, keeping its host-reported state",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "source-builtin",
        "provider": "copilot",
        "displayName": "Example subscription",
        "state": {
          "kind": "ready"
        }
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "source-builtin",
        "provider": "copilot",
        "displayName": "Example subscription (renamed)"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "source-builtin",
        "provider": "copilot",
        "displayName": "Example subscription (renamed)",
        "state": {
          "kind": "ready"
        }
      }
    ]
  }
}
