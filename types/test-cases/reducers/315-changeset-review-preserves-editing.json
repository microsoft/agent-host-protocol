{
  "description": "changeset/filesReviewChanged changes the Viewed flag without changing editing activity or the nonce",
  "reducer": "changeset",
  "initial": {
    "status": "ready",
    "files": [
      { "id": "file:///a.txt", "edit": {}, "nonce": "a-1", "isEditing": true }
    ]
  },
  "actions": [
    { "type": "changeset/filesReviewChanged", "files": ["file:///a.txt"], "reviewed": true }
  ],
  "expected": {
    "status": "ready",
    "files": [
      { "id": "file:///a.txt", "edit": {}, "nonce": "a-1", "isEditing": true, "reviewed": true }
    ]
  }
}
