{
  "description": "root/modelSourceRegistrationSet compares definition numbers by numeric value, so 4096 and 4096.0, 0.5 and 0.50, and 1e3 and 1000 are the same routing: the client joins, and the host-reported fields are kept",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-n",
        "provider": "copilot",
        "displayName": "Numbers",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apin.example.com/v1",
          "maxOutputTokens": 4096,
          "temperature": 0.5,
          "limits": {
            "rpm": 1e3
          }
        },
        "contributingClientIds": [
          "client-1"
        ],
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-n-1",
        "credentialId": "key-n-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceRegistrationSet",
      "registration": {
        "id": "model-source-n",
        "provider": "copilot",
        "displayName": "Numbers",
        "format": "example.com/model-source@1",
        "definition": {
          "limits": {
            "rpm": 1000
          },
          "temperature": 0.50,
          "maxOutputTokens": 4096.0,
          "baseUrl": "https://apin.example.com/v1"
        }
      },
      "clientId": "client-2"
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-n",
        "provider": "copilot",
        "displayName": "Numbers",
        "format": "example.com/model-source@1",
        "definition": {
          "limits": {
            "rpm": 1000
          },
          "temperature": 0.50,
          "maxOutputTokens": 4096.0,
          "baseUrl": "https://apin.example.com/v1"
        },
        "contributingClientIds": [
          "client-1",
          "client-2"
        ],
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-n-1",
        "credentialId": "key-n-1"
      }
    ]
  }
}
