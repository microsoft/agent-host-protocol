{
  "description": "root/modelSourceRegistrationSet replaces the registration with the same id in place. A client's replacement carries no state or credentialNonce, so it clears the reported status until the host reports again, and its clientId becomes the contributing client",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1",
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-a-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceRegistrationSet",
      "registration": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a (renamed)",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-2"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a (renamed)",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-2"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1"
      }
    ]
  }
}
