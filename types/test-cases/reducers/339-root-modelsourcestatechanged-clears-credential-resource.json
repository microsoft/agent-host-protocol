{
  "description": "root/modelSourceStateChanged without credentialResource clears the registration's existing one, for a source that turns out to need no credential",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1",
        "state": {
          "kind": "authRequired",
          "reason": "required"
        },
        "credentialNonce": "nonce-a-1",
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        }
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-a",
      "state": {
        "kind": "ready"
      },
      "credentialNonce": "nonce-a-2"
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1",
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-a-2"
      }
    ]
  }
}
