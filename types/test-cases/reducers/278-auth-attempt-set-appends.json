{
  "description": "accounts/authAttemptSet appends a pending MCP admission",
  "reducer": "accounts",
  "initial": { "accounts": [], "attempts": [] },
  "actions": [{
    "type": "accounts/authAttemptSet",
    "attempt": {
      "id": "attempt-1", "status": "pending", "resource": "https://tools.example.test",
      "consumer": { "kind": "mcpServer", "session": "ahp-session:/one", "customizationId": "server-1" }
    }
  }],
  "expected": {
    "accounts": [],
    "attempts": [{
      "id": "attempt-1", "status": "pending", "resource": "https://tools.example.test",
      "consumer": { "kind": "mcpServer", "session": "ahp-session:/one", "customizationId": "server-1" }
    }]
  }
}
