{
  "description": "root/agentsChanged atomically replaces provider descriptors and duplicate-raw-ID model rows without retaining stale catalog entries",
  "reducer": "root",
  "initial": {
    "activeSessions": 2,
    "agents": [{
      "provider": "example", "displayName": "Example", "description": "Old catalog",
      "capabilities": { "modelProviderSelection": {} },
      "modelProviders": [{ "id": "retired", "displayName": "Retired" }],
      "models": [{ "id": "shared-model", "provider": "example", "name": "Shared", "modelProviderId": "retired" }]
    }]
  },
  "actions": [{
    "type": "root/agentsChanged",
    "agents": [{
      "provider": "example", "displayName": "Example", "description": "New catalog",
      "capabilities": { "modelProviderSelection": {} },
      "modelProviders": [
        { "id": "source-a", "displayName": "A" },
        { "id": "source-b", "displayName": "B" },
        { "id": "source-c", "displayName": "Known empty provider" }
      ],
      "models": [
        { "id": "shared-model", "provider": "example", "name": "Shared", "modelProviderId": "source-a" },
        { "id": "shared-model", "provider": "example", "name": "Shared", "modelProviderId": "source-b" }
      ]
    }]
  }],
  "expected": {
    "activeSessions": 2,
    "agents": [{
      "provider": "example", "displayName": "Example", "description": "New catalog",
      "capabilities": { "modelProviderSelection": {} },
      "modelProviders": [
        { "id": "source-a", "displayName": "A" },
        { "id": "source-b", "displayName": "B" },
        { "id": "source-c", "displayName": "Known empty provider" }
      ],
      "models": [
        { "id": "shared-model", "provider": "example", "name": "Shared", "modelProviderId": "source-a" },
        { "id": "shared-model", "provider": "example", "name": "Shared", "modelProviderId": "source-b" }
      ]
    }]
  }
}
