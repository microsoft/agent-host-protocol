{
  "description": "A rich replacement for a missing target leaves the mixed set unchanged",
  "reducer": "session",
  "initial": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": ["file:///a", { "uri": "file:///b", "origin": { "kind": "local" } }]
  },
  "actions": [{
    "type": "session/workingDirectoryReplaced", "directory": "file:///missing",
    "replacement": { "uri": "file:///b", "repo": "https://example.org/project.git" }
  }],
  "expected": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": ["file:///a", { "uri": "file:///b", "origin": { "kind": "local" } }]
  }
}
