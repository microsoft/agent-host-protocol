{
  "description": "TCP: half close is independent and idempotent",
  "reducer": "tcp",
  "initial": {
    "session": "ahp-session:/s1",
    "target": {
      "host": "localhost",
      "port": 3000
    },
    "encoding": "base64",
    "input": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "output": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "clientClosed": false,
    "hostClosed": false
  },
  "actions": [
    {
      "type": "tcp/inputEof",
