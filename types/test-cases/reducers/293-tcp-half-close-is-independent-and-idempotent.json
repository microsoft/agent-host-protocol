  "expected": {
    "session": "ahp-session:/s1",
    "target": {
      "host": "localhost",
      "port": 3000
    },
    "encoding": "base64",
    "input": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0,
