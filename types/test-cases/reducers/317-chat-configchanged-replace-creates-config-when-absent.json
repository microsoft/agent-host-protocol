{
  "description": "chat/configChanged with replace creates the chat's config when it is absent",
  "reducer": "chat",
  "initial": {
    "turns": [],
    "resource": "ahp-chat:/c2",
    "title": "Other agent",
    "status": 1,
    "modifiedAt": "1970-01-01T00:00:01.000Z",
    "provider": "other-agent"
  },
  "actions": [
    {
      "type": "chat/configChanged",
      "config": {
        "autoApprove": true
      },
      "replace": true
    }
  ],
  "expected": {
    "turns": [],
    "resource": "ahp-chat:/c2",
    "title": "Other agent",
    "status": 1,
    "modifiedAt": "1970-01-01T00:00:01.000Z",
    "provider": "other-agent",
    "config": {
      "values": {
        "autoApprove": true
      }
    }
  }
}
