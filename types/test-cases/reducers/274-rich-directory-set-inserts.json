{
  "description": "Rich directory set creates the set and retains complete provenance",
  "reducer": "session",
  "initial": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": []
  },
  "actions": [{
    "type": "session/workingDirectorySet",
    "directory": {
      "uri": "file:///work/tree/packages/api", "repo": "https://example.org/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///work/main" }
    }
  }],
  "expected": {
    "provider": "example", "title": "Directories", "status": 1,
    "lifecycle": "ready", "activeClients": [], "chats": [],
    "workingDirectories": [{
      "uri": "file:///work/tree/packages/api", "repo": "https://example.org/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///work/main" }
    }]
  }
}
