{
  "description": "Resolved directory provenance survives readiness and config changes without echoing creation inputs",
  "reducer": "session",
  "initial": {
    "provider": "example",
    "title": "Repository session",
    "status": 1,
    "lifecycle": "creating",
    "activeClients": [],
    "chats": [],
    "config": {
      "schema": { "type": "object", "properties": { "mode": { "type": "string", "title": "Mode" } } },
      "values": { "mode": "review" }
    }
  },
  "actions": [
    { "type": "session/workingDirectorySet", "directory": {
      "uri": "file:///work/project",
      "repo": "https://example.org/team/project.git",
      "origin": { "kind": "repo" }
    } },
    { "type": "session/ready" },
    { "type": "session/configChanged", "config": { "mode": "interactive" }, "replace": true },
    { "type": "session/workingDirectorySet", "directory": {
      "uri": "file:///work/project-worktree/packages/api",
      "repo": "https://example.org/team/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///work/project" }
    } },
    { "type": "session/workingDirectoryRemoved", "directory": "file:///work/project" }
  ],
  "expected": {
    "provider": "example",
    "title": "Repository session",
    "status": 1,
    "lifecycle": "ready",
    "activeClients": [],
    "chats": [],
    "workingDirectories": [{
      "uri": "file:///work/project-worktree/packages/api",
      "repo": "https://example.org/team/project.git",
      "origin": { "kind": "worktree", "mainWorktree": "file:///work/project" }
    }],
    "config": {
      "schema": { "type": "object", "properties": { "mode": { "type": "string", "title": "Mode" } } },
      "values": { "mode": "interactive" }
    }
  }
}
