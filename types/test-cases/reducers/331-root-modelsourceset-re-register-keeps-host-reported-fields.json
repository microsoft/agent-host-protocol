{
  "description": "root/modelSourceSet with the same provider, format, and nonce re-registers: it keeps every host-reported field (state, credentialResource, and accountId) and takes everything else from the action, including displayName, icons, retention, and _meta",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "state": {
          "kind": "ready"
        },
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "accountId": "account-a-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a (renamed)",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "icons": [
          {
            "src": "https://apia.example.com/icon.png"
          }
        ],
        "retention": "host",
        "_meta": {
          "example.com/window": "2"
        }
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a (renamed)",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "icons": [
          {
            "src": "https://apia.example.com/icon.png"
          }
        ],
        "retention": "host",
        "_meta": {
          "example.com/window": "2"
        },
        "state": {
          "kind": "ready"
        },
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "accountId": "account-a-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1"
      }
    ]
  }
}
