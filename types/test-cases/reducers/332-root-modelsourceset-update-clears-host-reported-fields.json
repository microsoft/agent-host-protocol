{
  "description": "root/modelSourceSet with a different nonce updates the model source: it replaces the source, including its definition, and clears the host-reported fields until the host reports again",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "state": {
          "kind": "ready"
        },
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "accountId": "account-a-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v2",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v2"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v2",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v2"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1"
      }
    ]
  }
}
