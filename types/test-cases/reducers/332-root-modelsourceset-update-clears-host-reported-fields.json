{
  "description": "root/modelSourceSet with a different nonce updates the model source: it replaces the source and clears the host-reported fields until the host reports again",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1",
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-a-1",
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "credentialOrigins": [
          "https://apia.example.com"
        ],
        "accountId": "account-a-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "nonce": "definition-b-v1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v2"
      },
      "definition": {
        "baseUrl": "https://apia.example.com/v2",
        "models": [
          "model-a"
        ]
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v2"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "nonce": "definition-b-v1"
      }
    ]
  }
}
