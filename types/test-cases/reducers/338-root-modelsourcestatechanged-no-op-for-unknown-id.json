  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-removed",
      "state": {
        "kind": "ready"
      },
      "credentialNonce": "nonce-removed-1"
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1"
      }
    ]
  }
}
