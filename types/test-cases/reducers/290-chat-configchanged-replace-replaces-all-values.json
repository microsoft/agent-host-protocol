{
  "description": "chat/configChanged with replace replaces all of the chat's config values",
  "reducer": "chat",
  "initial": {
    "turns": [],
    "resource": "ahp-chat://session/peer",
    "title": "Peer Chat",
    "status": 1,
    "modifiedAt": "1970-01-01T00:00:01.000Z",
    "config": {
      "schema": {
        "type": "object",
        "properties": {
          "autoApprove": {
            "type": "boolean",
            "title": "Auto-approve tools",
            "sessionMutable": true
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "enum": [
              "agent",
              "plan"
            ],
            "sessionMutable": true
          }
        }
      },
      "values": {
        "autoApprove": false,
        "mode": "agent"
      }
    }
  },
  "actions": [
    {
      "type": "chat/configChanged",
      "config": {
        "autoApprove": true
      },
      "replace": true
    }
  ],
  "expected": {
    "turns": [],
    "resource": "ahp-chat://session/peer",
    "title": "Peer Chat",
    "status": 1,
    "modifiedAt": "1970-01-01T00:00:01.000Z",
    "config": {
      "schema": {
        "type": "object",
        "properties": {
          "autoApprove": {
            "type": "boolean",
            "title": "Auto-approve tools",
            "sessionMutable": true
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "enum": [
              "agent",
              "plan"
            ],
            "sessionMutable": true
          }
        }
      },
      "values": {
        "autoApprove": true
      }
    }
  }
}
