{
  "description": "root/modelSourceStateChanged is a no-op when no registration has the id, so a late status report can't bring back a removed registration",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a",
              "maxContextWindow": 128000
            }
          ],
          "headers": {
            "x-region": "eu",
            "x-tier": "pro"
          }
        },
        "contributingClientIds": [
          "client-1"
        ]
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-removed",
      "state": {
        "kind": "ready"
      },
      "credentialNonce": "nonce-removed-1"
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a",
              "maxContextWindow": 128000
            }
          ],
          "headers": {
            "x-region": "eu",
            "x-tier": "pro"
          }
        },
        "contributingClientIds": [
          "client-1"
        ]
      }
    ]
  }
}
