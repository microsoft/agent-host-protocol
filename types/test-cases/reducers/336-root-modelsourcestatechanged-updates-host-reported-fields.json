{
  "description": "root/modelSourceStateChanged sets the matching registration's state, credentialNonce, and credentialResource together, preserving its other fields and the registry order",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1",
        "retention": "host",
        "state": {
          "kind": "starting"
        },
        "credentialNonce": "nonce-b-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-b",
      "state": {
        "kind": "authRequired",
        "reason": "required"
      },
      "credentialNonce": "nonce-b-2",
      "credentialResource": {
        "resource": "https://apib.example.com/v1",
        "resource_name": "Source b API key"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1",
        "retention": "host",
        "state": {
          "kind": "authRequired",
          "reason": "required"
        },
        "credentialNonce": "nonce-b-2",
        "credentialResource": {
          "resource": "https://apib.example.com/v1",
          "resource_name": "Source b API key"
        }
      }
    ]
  }
