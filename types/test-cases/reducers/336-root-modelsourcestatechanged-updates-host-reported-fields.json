{
  "description": "root/modelSourceStateChanged sets the matching model source's state, credentialResource, and accountId together, adding credential fields it didn't have, and preserves its other fields and the registry order",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1",
        "retention": "host",
        "state": {
          "kind": "starting"
        }
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "modelSourceId": "model-source-b",
      "state": {
        "kind": "authRequired",
        "reason": "rejected",
        "description": "The endpoint rejected the API key."
      },
      "credentialResource": {
        "resource": "https://apib.example.com/v1",
        "resource_name": "Source b API key"
      },
      "accountId": "account-b-1"
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "displayName": "Source b",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apib.example.com/v1",
          "models": [
            {
              "id": "model-b"
            }
          ]
        },
        "nonce": "definition-b-v1",
        "retention": "host",
        "state": {
          "kind": "authRequired",
          "reason": "rejected",
          "description": "The endpoint rejected the API key."
        },
        "credentialResource": {
          "resource": "https://apib.example.com/v1",
          "resource_name": "Source b API key"
        },
        "accountId": "account-b-1"
      }
    ]
  }
}
