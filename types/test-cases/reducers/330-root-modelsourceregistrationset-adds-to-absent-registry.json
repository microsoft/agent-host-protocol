{
  "description": "root/modelSourceRegistrationSet adds a registration to an absent registry, with the dispatching client as its only contributor",
  "reducer": "root",
  "initial": {
    "agents": []
  },
  "actions": [
    {
      "type": "root/modelSourceRegistrationSet",
      "registration": {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a",
              "maxContextWindow": 128000
            }
          ],
          "headers": {
            "x-region": "eu",
            "x-tier": "pro"
          }
        }
      },
      "clientId": "client-1"
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a",
              "maxContextWindow": 128000
            }
          ],
          "headers": {
            "x-region": "eu",
            "x-tier": "pro"
          }
        },
        "contributingClientIds": [
          "client-1"
        ]
      }
    ]
  }
}
