{
  "description": "root/modelSourceStateChanged without credentialResource, credentialOrigins, or accountId clears the model source's existing ones, for a source that turns out to need no credential",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1",
        "state": {
          "kind": "starting"
        },
        "credentialNonce": "nonce-a-1",
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "credentialOrigins": [
          "https://apia.example.com"
        ],
        "accountId": "account-a-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-a",
      "state": {
        "kind": "ready"
      },
      "credentialNonce": "nonce-a-2"
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "nonce": "definition-a-v1",
        "state": {
          "kind": "ready"
        },
        "credentialNonce": "nonce-a-2"
      }
    ]
  }
}
