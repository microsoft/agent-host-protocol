{
  "description": "root/modelSourceStateChanged without credentialResource or accountId clears the model source's existing ones, for a source that turns out to need no credential",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "state": {
          "kind": "starting"
        },
        "credentialResource": {
          "resource": "https://apia.example.com/v1",
          "resource_name": "Source a API key"
        },
        "accountId": "account-a-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "modelSourceId": "model-source-a",
      "state": {
        "kind": "ready"
      }
    }
  ],
  "expected": {
    "agents": [],
    "modelSources": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "displayName": "Source a",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://apia.example.com/v1",
          "models": [
            {
              "id": "model-a"
            }
          ]
        },
        "nonce": "definition-a-v1",
        "state": {
          "kind": "ready"
        }
      }
    ]
  }
}
