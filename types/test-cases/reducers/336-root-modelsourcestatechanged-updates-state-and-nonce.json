{
  "description": "root/modelSourceStateChanged replaces only the matching registration's state and credentialNonce, preserving its other fields and the registry order",
  "reducer": "root",
  "initial": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "name": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "name": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1",
        "retention": "host",
        "state": {
          "kind": "starting"
        },
        "credentialNonce": "nonce-b-1"
      }
    ]
  },
  "actions": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "model-source-b",
      "state": {
        "kind": "authRequired",
        "reason": "required",
        "resource": {
          "resource": "https://apib.example.com/v1",
          "resource_name": "Source b API key"
        }
      },
      "credentialNonce": "nonce-b-2"
    }
  ],
  "expected": {
    "agents": [],
    "modelSourceRegistrations": [
      {
        "id": "model-source-a",
        "provider": "copilot",
        "name": "Source a",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apia.example.com/v1",
          "models": [
            "model-a"
          ]
        },
        "clientId": "client-1"
      },
      {
        "id": "model-source-b",
        "provider": "copilot",
        "name": "Source b",
        "format": "example.com/model-source@1",
        "definition": {
          "baseUrl": "https://apib.example.com/v1",
          "models": [
            "model-b"
          ]
        },
        "clientId": "client-1",
        "retention": "host",
        "state": {
          "kind": "authRequired",
          "reason": "required",
          "resource": {
            "resource": "https://apib.example.com/v1",
            "resource_name": "Source b API key"
          }
        },
        "credentialNonce": "nonce-b-2"
      }
    ]
