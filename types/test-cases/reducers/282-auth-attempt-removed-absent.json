{
  "description": "accounts/authAttemptRemoved is a no-op for an absent attempt",
  "reducer": "accounts",
  "initial": {
    "accounts": [],
    "attempts": [{
      "id": "attempt-1", "status": "pending", "resource": "https://api.example.test",
      "consumer": { "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" }
    }]
  },
  "actions": [{ "type": "accounts/authAttemptRemoved", "id": "absent" }],
  "expected": {
    "accounts": [],
    "attempts": [{
      "id": "attempt-1", "status": "pending", "resource": "https://api.example.test",
      "consumer": { "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" }
    }]
  }
}
