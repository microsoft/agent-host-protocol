{
  "description": "TCP: rejects output data after close",
  "reducer": "tcp",
  "initial": {
    "session": "ahp-session:/s1",
    "target": {
      "host": "localhost",
      "port": 3000
    },
    "encoding": "base64",
    "input": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "output": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "clientClosed": false,
    "hostClosed": true
  },
  "actions": [
    {
      "type": "tcp/data",
      "offset": 0,
      "data": "AA=="
    }
  ],
  "expected": {
    "session": "ahp-session:/s1",
    "target": {
      "host": "localhost",
      "port": 3000
    },
    "encoding": "base64",
    "input": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "output": {
      "windowBytes": 8,
      "maximumChunkSize": 6,
      "receivedBytes": 0,
      "consumedBytes": 0
    },
    "clientClosed": false,
    "hostClosed": true
  },
  "expectedError": "Invalid TCP action: data after EOF or sender close"
}
