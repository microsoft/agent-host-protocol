{
  "name": "repository-session-source-only",
  "group": "A",
  "description": "A ready session preserves the standard repositorySource property and requested URI, omits the optional revision, and resolves one source to multiple directories.",
  "type": "Snapshot",
  "input": {
    "resource": "ahp-session:/repository-session",
    "state": {
      "provider": "example",
      "title": "Repository session",
      "status": 1,
      "lifecycle": "ready",
      "activeClients": [],
      "chats": [],
      "workingDirectories": ["file:///work/project", "file:///work/project-worktree"],
      "config": {
        "schema": {
          "type": "object",
          "properties": {
            "repositorySource": { "type": "string", "title": "Repository" }
          }
        },
        "values": { "repositorySource": "https://example.org/team/project.git" }
      }
    },
    "fromSeq": 2
