          },
          "repository": { "urlProperty": "source_uri", "revisionProperty": "source_ref" }
        },
        "values": { "source_uri": "https://example.org/team/project.git", "source_ref": "refs/tags/v1.2.3" }
      }
    },
    "fromSeq": 0
  }]
}
