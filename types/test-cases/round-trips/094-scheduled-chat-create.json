{
  "name": "scheduled-chat-create",
  "group": "A",
  "description": "A one-time scheduled chat preserves its purpose and exact non-default conversation target.",
  "type": "StateAction",
  "input": {
    "type": "automation/createRequested",
    "resource": "ahp-automation:/send-later",
    "definition": {
      "title": "Send the follow-up",
      "purpose": "scheduledChat",
      "conversation": { "session": "ahp-session:/existing", "chat": "ahp-chat:/non-default" },
      "message": { "text": "Follow up", "origin": { "kind": "automation" } },
      "session": { "provider": "demo", "workingDirectories": ["file:///workspace"] },
      "enabled": true,
      "triggers": [{ "id": "once", "kind": "oneTime", "runAt": "2026-11-14T09:00:00Z" }]
    }
  },
  "acceptableOutputs": [{
    "type": "automation/createRequested",
    "resource": "ahp-automation:/send-later",
    "definition": {
      "title": "Send the follow-up",
      "purpose": "scheduledChat",
      "conversation": { "session": "ahp-session:/existing", "chat": "ahp-chat:/non-default" },
      "message": { "text": "Follow up", "origin": { "kind": "automation" } },
      "session": { "provider": "demo", "workingDirectories": ["file:///workspace"] },
      "enabled": true,
      "triggers": [{ "id": "once", "kind": "oneTime", "runAt": "2026-11-14T09:00:00Z" }]
    }
  }]
}
