    "token": "test-credential", "scopes": ["read"], "expiresIn": 3600,
    "binding": { "kind": "attempt", "attemptId": "one" }
  },
  "acceptableOutputs": [{
    "channel": "ahp-root://", "resource": "https://api.example.test",
    "token": "test-credential", "scopes": ["read"], "expiresIn": 3600,
    "binding": { "kind": "attempt", "attemptId": "one" }
  }]
}
