{
  "name": "authenticate-model-source-target",
  "group": "A",
  "description": "authenticate delivers an opaque secret for one registered model source through a modelSource target, and names the key with the existing accountId parameter. An API key carries no expiresIn or scopes.",
  "type": "AuthenticateParams",
  "input": {
    "channel": "ahp-root://",
    "resource": "https://openrouter.ai/api/v1",
    "token": "test-api-key",
    "accountId": "keychain-openrouter-1",
    "target": {
      "kind": "modelSource",
      "modelSourceId": "source-new"
    }
  },
  "acceptableOutputs": [
    {
      "channel": "ahp-root://",
      "resource": "https://openrouter.ai/api/v1",
      "token": "test-api-key",
      "accountId": "keychain-openrouter-1",
      "target": {
        "kind": "modelSource",
        "modelSourceId": "source-new"
      }
    }
  ]
}
