{
  "name": "authenticate-account-binding",
  "group": "A",
  "description": "Rotated credentials retain the account lifetime rather than silently becoming unbound pushes.",
  "type": "AuthenticateParams",
  "input": {
    "channel": "ahp-root://", "resource": "https://api.example.test",
    "token": "rotated-test-credential",
    "binding": { "kind": "account", "accountId": "account-a" }
  },
  "acceptableOutputs": [{
    "channel": "ahp-root://", "resource": "https://api.example.test",
    "token": "rotated-test-credential",
    "binding": { "kind": "account", "accountId": "account-a" }
  }]
}
