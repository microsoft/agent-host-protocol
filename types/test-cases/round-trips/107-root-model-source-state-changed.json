{
  "name": "root-model-source-state-changed",
  "group": "A",
  "description": "The host reports a registration's status with root/modelSourceStateChanged, issuing a credential nonce and the credentialResource the key is for, here asking for an API key.",
  "type": "StateAction",
  "input": {
    "type": "root/modelSourceStateChanged",
    "id": "source-new",
    "state": {
      "kind": "authRequired",
      "reason": "required",
      "description": "The endpoint needs an API key."
    },
    "credentialNonce": "nonce-openrouter-1",
    "credentialResource": {
      "resource": "https://openrouter.ai/api/v1",
      "resource_name": "OpenRouter API key"
    }
  },
  "acceptableOutputs": [
    {
      "type": "root/modelSourceStateChanged",
      "id": "source-new",
      "state": {
        "kind": "authRequired",
        "reason": "required",
        "description": "The endpoint needs an API key."
      },
      "credentialNonce": "nonce-openrouter-1",
      "credentialResource": {
        "resource": "https://openrouter.ai/api/v1",
        "resource_name": "OpenRouter API key"
      }
    }
  ]
}
