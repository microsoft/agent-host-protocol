{
  "name": "root-model-source-state-changed",
  "group": "A",
  "description": "The host reports with root/modelSourceStateChanged that the endpoint rejected a key, naming the rejected key's accountId, along with the credentialResource the key is for.",
  "type": "StateAction",
  "input": {
    "type": "root/modelSourceStateChanged",
    "modelSourceId": "source-new",
    "state": {
      "kind": "authRequired",
      "reason": "rejected",
      "description": "The endpoint rejected the API key."
    },
    "credentialResource": {
      "resource": "https://openrouter.ai/api/v1",
      "resource_name": "OpenRouter API key"
    },
    "accountId": "keychain-openrouter-1"
  },
  "acceptableOutputs": [
    {
      "type": "root/modelSourceStateChanged",
      "modelSourceId": "source-new",
      "state": {
        "kind": "authRequired",
        "reason": "rejected",
        "description": "The endpoint rejected the API key."
      },
      "credentialResource": {
        "resource": "https://openrouter.ai/api/v1",
        "resource_name": "OpenRouter API key"
      },
      "accountId": "keychain-openrouter-1"
    }
  ]
}
