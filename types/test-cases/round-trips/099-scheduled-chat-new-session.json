{
  "name": "scheduled-chat-new-session",
  "group": "A",
  "description": "Explicit new-session scheduling retains captured configuration and omits an existing-conversation target.",
  "type": "StateAction",
  "input": {
    "type": "automation/createRequested",
    "resource": "ahp-automation:/new-session",
    "definition": {
      "title": "Review later",
      "purpose": "scheduledChat",
      "message": { "text": "Review the repository", "origin": { "kind": "automation" } },
      "session": {
        "provider": "demo",
        "model": { "id": "captured-model" },
        "workingDirectories": ["file:///workspace"],
        "config": { "permission": "default" }
      },
      "enabled": true,
      "triggers": [{ "id": "once", "kind": "oneTime", "runAt": "2026-11-14T09:00:00Z" }]
    }
  },
  "acceptableOutputs": [{
    "type": "automation/createRequested",
    "resource": "ahp-automation:/new-session",
    "definition": {
      "title": "Review later",
      "purpose": "scheduledChat",
      "message": { "text": "Review the repository", "origin": { "kind": "automation" } },
      "session": {
        "provider": "demo",
        "model": { "id": "captured-model" },
        "workingDirectories": ["file:///workspace"],
        "config": { "permission": "default" }
      },
      "enabled": true,
      "triggers": [{ "id": "once", "kind": "oneTime", "runAt": "2026-11-14T09:00:00Z" }]
    }
  }]
}
