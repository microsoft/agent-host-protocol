      "provider": "example",
      "displayName": "OpenRouter",
      "format": "example.com/model-source@1",
      "definition": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "models": [
          "vendor/model-a",
          "vendor/model-b"
        ],
        "headers": {
          "x-title": "Example"
        }
      },
      "clientId": "client-1",
      "retention": "host"
    }
