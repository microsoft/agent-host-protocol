{
  "name": "model-source-registry-snapshot",
  "group": "A",
  "description": "A root snapshot carries model source registrations with no reported state and in each lifecycle state, including an http endpoint and a host-registered source without clientId. Sources that take a credential carry a host-reported credentialResource in every state, including ready. The agent advertises the modelSourceRegistration capability, and its catalog lists the ready registration and the authRequired one whose key expired, since models stay listed after a registration has been ready.",
  "type": "Snapshot",
  "input": {
    "resource": "ahp-root://",
    "fromSeq": 4,
    "state": {
      "agents": [
        {
          "provider": "example",
          "displayName": "Example",
          "description": "Serves registered model sources",
          "capabilities": {
            "modelSourceRegistration": {
              "formats": [
                "example.com/model-source@1",
                "example.com/model-source@0"
              ]
            }
          },
          "modelSources": [
            {
              "id": "source-ready",
              "displayName": "OpenRouter"
            },
            {
              "id": "source-auth",
              "displayName": "Azure endpoint"
            }
          ],
          "models": [
            {
              "id": "source-ready.8f3a",
              "provider": "example",
              "name": "Example model",
              "vendor": "OpenRouter",
              "modelSourceId": "source-ready"
            },
            {
              "id": "source-auth.c71e",
              "provider": "example",
              "name": "Example model",
              "vendor": "Azure OpenAI",
              "modelSourceId": "source-auth"
            }
          ]
        }
      ],
      "modelSourceRegistrations": [
        {
          "id": "source-unreported",
          "provider": "example",
          "displayName": "Unreported",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "https://api.example.com/v1",
            "wireFormat": "openai-chat",
            "models": [
              {
                "id": "example-model",
                "maxContextWindow": 128000
              }
            ]
          },
          "clientId": "client-1"
        },
        {
          "id": "source-starting",
          "provider": "example",
          "displayName": "Starting",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "https://api.example.com/v1",
            "wireFormat": "openai-chat",
            "models": [
              {
                "id": "example-model",
                "maxContextWindow": 128000
              }
            ]
          },
          "clientId": "client-1",
          "state": {
            "kind": "starting"
          },
          "credentialNonce": "nonce-starting-1"
        },
        {
          "id": "source-ready",
          "provider": "example",
          "displayName": "OpenRouter",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "https://api.example.com/v1",
            "wireFormat": "openai-chat",
            "models": [
              {
                "id": "example-model",
                "maxContextWindow": 128000
              }
            ]
          },
          "clientId": "client-1",
          "icons": [
            {
              "src": "https://example.com/openrouter.svg"
            }
          ],
          "retention": "host",
          "state": {
            "kind": "ready"
          },
          "credentialNonce": "nonce-ready-1",
          "credentialResource": {
            "resource": "https://api.example.com/v1",
            "resource_name": "OpenRouter API key"
          },
          "_meta": {
            "example.com/label": "Laptop"
          }
        },
        {
          "id": "source-auth",
          "provider": "example",
          "displayName": "Azure endpoint",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "https://example.openai.azure.com/openai/v1",
            "wireFormat": "openai-chat",
            "models": [
              {
                "id": "example-model",
                "maxContextWindow": 128000
              }
            ]
          },
          "clientId": "client-1",
          "retention": "contributingClient",
          "state": {
            "kind": "authRequired",
            "reason": "expired",
            "description": "The access token expired."
          },
          "credentialNonce": "nonce-auth-1",
          "credentialResource": {
            "resource": "https://example.openai.azure.com/openai/v1",
            "resource_name": "Azure OpenAI",
            "authorization_servers": [
              "https://login.microsoftonline.com/common/v2.0"
            ],
            "scopes_supported": [
              "https://cognitiveservices.azure.com/.default"
            ]
          }
        },
        {
          "id": "source-local",
          "provider": "example",
          "displayName": "Local server",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "http://localhost:11434/v1"
          },
          "clientId": "client-1",
          "state": {
            "kind": "authRequired",
            "reason": "required"
          },
          "credentialNonce": "nonce-local-1",
          "credentialResource": {
            "resource": "http://localhost:11434/v1",
            "resource_name": "Local server key"
          }
        },
        {
          "id": "source-host",
          "provider": "example",
          "displayName": "Host-configured",
          "format": "example.com/model-source@1",
          "definition": {
            "baseUrl": "https://models.internal.example/v1"
          },
          "state": {
            "kind": "error",
            "error": {
              "errorType": "policy",
              "message": "The endpoint is not allowed by host policy."
            }
          },
          "credentialNonce": "nonce-host-1"
        }
      ]
    }
  },
