            }
          },
          "state": {
            "kind": "authRequired",
            "reason": "revoked"
          },
          "credentialResource": {
            "resource": "https://api.example.com/v1",
            "resource_name": "OpenRouter API key"
          },
          "accountId": "keychain-revoked-1"
        },
        {
          "id": "source-host",
          "provider": "example",
          "displayName": "Host-configured",
          "registration": {
            "format": "example.com/model-source@1",
            "definition": {
              "endpoint": "https://models.internal.example.com",
              "routing": {
                "region": "example-1"
              }
            }
          },
          "state": {
            "kind": "error",
            "error": {
              "errorType": "policy",
              "message": "The endpoint is not allowed by host policy."
            }
          }
        }
      ]
    }
  },
