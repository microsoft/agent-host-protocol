{
  "name": "model-source-registry-snapshot",
  "group": "A",
  "description": "A root snapshot carries model source registrations with no reported state and in each lifecycle state and auth reason (required, expired, rejected, and revoked), including an http endpoint, a source two clients contribute, a host-retained source whose contributors have all left, and a host-registered source. Sources that take a credential carry a host-reported credentialResource and credentialOrigins in every state, and credentialId once the host has accepted a key. The agent advertises the modelSourceRegistration capability with its formats, contributor grace period, and principal policy, and its catalog lists the ready registration and the authRequired one whose key expired, since models stay listed after a registration has been ready.",
  "type": "Snapshot",
  "input": {
    "resource": "ahp-root://",
    "fromSeq": 4,
    "state": {
      "agents": [
        {
          "provider": "example",
          "displayName": "Example",
          "description": "Serves registered model sources",
          "capabilities": {
            "modelSourceRegistration": {
              "formats": [
                "example.com/model-source@1",
                "example.com/model-source@0"
              ],
              "gracePeriod": 30000,
              "principalPolicy": "shared"
            }
          },
          "modelSources": [
            {
              "id": "source-ready",
              "displayName": "OpenRouter"
            },
            {
              "id": "source-auth",
              "displayName": "Azure endpoint"
            }
          ],
          "models": [
            {
              "id": "source-ready.8f3a",
              "provider": "example",
              "name": "Example model",
              "vendor": "OpenRouter",
              "modelSourceId": "source-ready"
            },
            {
              "id": "source-auth.c71e",
              "provider": "example",
              "name": "Example model",
              "vendor": "Azure OpenAI",
              "modelSourceId": "source-auth"
            }
          ]
        }
      ],
      "modelSourceRegistrations": [
        {
          "id": "source-unreported",
          "provider": "example",
          "displayName": "Unreported",
          "format": "example.com/model-source@1",
