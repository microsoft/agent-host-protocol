{
  "name": "automation-disable-condition-snapshot",
  "group": "A",
  "description": "A catalogue snapshot preserves both OR-combined disable conditions and the host-owned scheduled-run usage count.",
  "type": "Snapshot",
  "input": {
    "resource": "ahp-automations://",
    "state": {
      "entries": [{
        "resource": "ahp-automation:/capped",
        "definition": {
          "title": "Capped triage",
          "message": { "text": "Triage the issue", "origin": { "kind": "automation" } },
          "session": { "provider": "copilot" },
          "enabled": false,
          "triggers": [{
            "id": "every-three-hours",
            "kind": "schedule",
            "schedule": { "expression": "0 */3 * * *", "timeZone": "Etc/UTC" },
            "misfirePolicy": "runOnce"
          }],
          "disableConditions": [
            { "kind": "afterRuns", "max": 3 },
            { "kind": "afterDate", "date": "2026-08-07T00:00:00Z" }
          ]
        },
        "runCount": 3,
        "runs": [],
        "operations": ["update", "remove", "run"],
        "createdAt": "2026-08-01T00:00:00Z",
        "modifiedAt": "2026-08-05T12:00:00Z"
      }]
    },
    "fromSeq": 9
  },
