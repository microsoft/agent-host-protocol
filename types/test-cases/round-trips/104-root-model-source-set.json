{
  "name": "root-model-source-set",
  "group": "A",
  "description": "A client registers a model source with root/modelSourceSet: the source with its definition, in the suggested openaiCompatible shape plus a member the agent defines, a nonce for it, requested retention, and no host-reported fields.",
  "type": "StateAction",
  "input": {
    "type": "root/modelSourceSet",
    "modelSource": {
      "id": "source-new",
      "provider": "example",
      "displayName": "OpenRouter",
      "format": "openaiCompatible",
      "definition": {
        "endpoint": "https://openrouter.ai/api/v1",
        "wireApi": "chatCompletions",
        "models": [
          {
            "id": "vendor/model-a",
            "name": "Model A",
            "maxContextWindow": 200000,
            "supportsTools": true
          },
          {
            "id": "vendor/model-b"
          }
        ],
        "headers": {
          "x-title": "Example"
        }
      },
      "nonce": "sha256-new-1",
      "retention": "host"
    }
  },
  "acceptableOutputs": [
    {
      "type": "root/modelSourceSet",
      "modelSource": {
        "id": "source-new",
        "provider": "example",
        "displayName": "OpenRouter",
        "format": "openaiCompatible",
        "definition": {
          "endpoint": "https://openrouter.ai/api/v1",
          "wireApi": "chatCompletions",
          "models": [
            {
              "id": "vendor/model-a",
              "name": "Model A",
              "maxContextWindow": 200000,
              "supportsTools": true
            },
            {
              "id": "vendor/model-b"
            }
          ],
          "headers": {
            "x-title": "Example"
          }
        },
        "nonce": "sha256-new-1",
        "retention": "host"
      }
    }
  ]
}
