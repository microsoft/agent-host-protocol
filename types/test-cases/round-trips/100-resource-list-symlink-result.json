      { "name": "broken-link", "type": "file", "isSymlink": true },
      { "name": "README.md", "type": "file", "isSymlink": false }
    ]
  },
  "acceptableOutputs": [
    {
      "entries": [
        { "name": "src", "type": "directory" },
        { "name": "shared", "type": "directory", "isSymlink": true },
        { "name": "broken-link", "type": "file", "isSymlink": true },
        { "name": "README.md", "type": "file", "isSymlink": false }
      ]
    }
  ]
}
