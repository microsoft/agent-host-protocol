{
  "name": "resource-list-symlink-result",
  "group": "A",
  "description": "DirectoryEntry carries optional isSymlink: omitted stays absent on re-encode, while explicit true and false values are preserved alongside file and directory types.",
  "type": "ResourceListResult",
  "input": {
    "entries": [
      { "name": "src", "type": "directory" },
