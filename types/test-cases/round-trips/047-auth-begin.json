{
  "name": "auth-begin",
  "group": "A",
  "description": "Brokered admission targets an existing consumer and optionally names a live account.",
  "type": "AuthBeginParams",
  "input": {
    "channel": "ahp-accounts://",
    "target": { "consumer": { "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" } },
    "flows": [{ "kind": "clientBrokered" }],
    "accountId": "account-a"
  },
  "acceptableOutputs": [{
    "channel": "ahp-accounts://",
    "target": { "consumer": { "kind": "agent", "provider": "assistant", "resource": "https://api.example.test" } },
    "flows": [{ "kind": "clientBrokered" }],
    "accountId": "account-a"
  }]
}
