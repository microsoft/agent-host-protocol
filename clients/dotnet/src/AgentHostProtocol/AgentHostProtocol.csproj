<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.AgentHostProtocol</RootNamespace>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Microsoft.AgentHostProtocol</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.VisualStudioCode.AgentHostProtocol</PackageId>
    <Description>The Agent Host Protocol (AHP) client for .NET: an async JSON-RPC client, the pure state reducers, the default System.Text.Json serializer, a ClientWebSocket transport, and the multi-host runtime.</Description>
    <!-- The net8 asset is validated under the trimming and Native AOT analyzers.
         The default serializer uses generated System.Text.Json metadata. -->
    <IsTrimmable Condition="'$(TargetFramework)' == 'net8.0'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentHostProtocol.Abstractions/AgentHostProtocol.Abstractions.csproj" />
  </ItemGroup>

  <!-- Keep internal test seams out of the public API. Signed release builds
       receive the friend assembly's full public key from vscode-engineering;
       ordinary local builds use the simple assembly name. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentHostProtocol.Tests" Key="$(StrongNamePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- DI + options integration for AddAgentHostProtocol() and IOptions<ClientConfig>.
       Abstractions-only and lightweight (both ship in the shared framework on
       ASP.NET Core / worker hosts), keeping the runtime footprint minimal. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <!-- SourceLink: pairs with the snupkg symbol packages + PublishRepositoryUrl
       so consumers can step into normalized, reproducible source. PrivateAssets
       keeps the tooling package out of the consumer's dependency graph. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
